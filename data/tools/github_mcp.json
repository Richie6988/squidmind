{
  "schema_version": "2.0.0",
  "tool_id": "tool_mcp_001",
  "name": "github_mcp",
  "type": "mcp_server",
  "category": "version_control",
  "status": "active",
  
  "purpose": "GitHub operations via Model Context Protocol",
  
  "when_to_use": [
    "Manage repository issues",
    "Create or review pull requests",
    "Search code across repos"
  ],
  "when_NOT_to_use": [
    "Local git operations (use shell instead)",
    "When credentials are not configured"
  ],
  
  "server": {
    "url": "https://api.github.com/mcp",
    "protocol_version": "2024-11-05",
    "transport": "http",
    "transport_options": {
      "use_sse": false,
      "supports_streaming": true
    }
  },
  
  "authentication": {
    "type": "github_pat_fine_grained",
    "key_ref": "secrets/github/aquarium_fgpat",
    "scope": "repository_specific"
  },
  
  "capabilities": [
    "list_repositories",
    "read_repository_contents",
    "create_issue",
    "comment_on_issue",
    "create_pull_request",
    "review_pull_request",
    "search_code"
  ],
  
  "rate_limits": {
    "requests_per_hour": 5000,
    "comment": "Authenticated requests limit"
  },
  
  "discovery": {
    "supports_tool_discovery": true,
    "supports_capability_negotiation": true,
    "supported_versions": ["2024-11-05", "2024-10-07"]
  },
  
  "error_handling": {
    "auth_failed": "Token expired or invalid - check expires_at",
    "rate_limit": "Wait until reset time",
    "server_unavailable": "Fallback to direct git operations"
  },
  
  "performance": {"average_latency_ms": 800, "success_rate": 0.98}
}
