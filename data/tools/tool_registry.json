    "api_call": {
      "description": "External HTTP/HTTPS API service",
      "requires": [
        "endpoint_url",
        "authentication",
        "rate_limits"
      ],
      "risks": [
        "external_dependency",
        "api_quotas",
        "data_privacy"
      ]
    },
    "mcp_server": {
      "description": "Model Context Protocol compliant server",
      "requires": [
        "server_url",
        "protocol_version",
        "transport",
        "capabilities"
      ],
