# SquidMind Configuration

# Anthropic API Key (REQUIRED)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Brave Search API Key (optional, for better web search)
# Get free key at: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# GitHub Token (for MCP integration)
GITHUB_TOKEN=your_github_token_here

# Server Configuration
PORT=3000
NODE_ENV=development

# MCP Servers (optional)
# Add your MCP server URLs here
# GITHUB_MCP_URL=https://github-mcp.example.com/sse
# SLACK_MCP_URL=https://slack-mcp.example.com/sse
